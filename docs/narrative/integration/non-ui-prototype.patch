+  unique: true, collectible: true, weight: 100, paramSlots: [], requirements: [{ type: 'faction', value: SHU_F }],
+  titleKey: k(`event.shu.${r.slug}.title`, `${r.name}・並肩小事`), bodyKey: k(`event.shu.${r.slug}.body`, r.story),
